# Watan Kabab API — Umgebungsvariablen (in Railway → Service → Variables setzen)

# Zwei getrennte Railway-Postgres-Datenbanken (je "Add → Database → PostgreSQL"):
DATABASE_URL_RES=postgresql://user:pass@host:port/railway      # Reservierungs-DB
DATABASE_URL_ORDERS=postgresql://user:pass@host:port/railway   # Bestell-DB

# Admin-Zugang (admin.html)
ADMIN_PASSWORD=bitte-aendern
ADMIN_TOKEN=langer-zufaelliger-string-bitte-aendern

# Erlaubte Website-Domain (CORS). Für Tests "*", live die echte Domain:
CORS_ORIGIN=https://watan-kabab.de

# PORT wird von Railway automatisch gesetzt.
